total_customers = 0
total_sales = 0

while True:
    customer = input("\nEnter customer name (or Done to finish): ")

    if customer.lower() == "done":
        break

    total_customers += 1

    items = int(input("How many items is the customer buying? "))

    customer_total = 0
    prices = []

    count = 1

    while count <= items:
        print("\nItem", count)

        item_name = input("Enter item name: ")

        price = float(input("Enter price: "))
        quantity = int(input("Enter quantity: "))

        if price <= 0 or quantity <= 0:
            print("Invalid price or quantity. Enter again.")
            continue

        item_total = price * quantity
        customer_total += item_total

        # Store prices for category report
        for i in range(quantity):
            prices.append(price)

        print(item_name, "Total = ₹", item_total)

        count += 1

    print("\nCustomer:", customer)
    print("Bill Total = ₹", customer_total)

    print("\nPrice Category Report")

    low = 0
    medium = 0
    high = 0

    for price in prices:
        if price < 100:
            low += 1
        elif price <= 500:
            medium += 1
        else:
            high += 1

    print("Below ₹100:", low)
    print("₹100 - ₹500:", medium)
    print("Above ₹500:", high)

    total_sales += customer_total


print("\n----- FINAL REPORT -----")
print("Total Customers:", total_customers)
print("Total Sales = ₹", total_sales)