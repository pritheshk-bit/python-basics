
habit = ("Reading", "Daily", 30, "Minutes")

week = (True, True, False, True, True, False, True)

print("Habit Details:", habit)
print("Weekly Record:", week)

print("Habit Name:", habit[0])
print("Frequency:", habit[1])
print("Duration:", habit[2])
print("Unit:", habit[3])

