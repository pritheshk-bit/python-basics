# 1. Star Pyramid
rows = 5

print("Star Pyramid")
for i in range(1, rows + 1):
    print("* " * i)


# 2. Floyd's Triangle
print("\nFloyd's Triangle")

num = 1
for i in range(1, rows + 1):
    for j in range(i):
        print(num, end=" ")
        num += 1
    print()


# 3. Diamond Pattern
print("\nDiamond Pattern")

# Upper half
for i in range(1, rows + 1):
    print(" " * (rows - i) + "* " * i)

# Lower half
for i in range(rows - 1, 0, -1):
    print(" " * (rows - i) + "* " * i)