
students = {
    "S101": {"name": "Rahul", "marks": 85},
    "S102": {"name": "Priya", "marks": 90},
    "S103": {"name": "Arun", "marks": 78}
}

print("Student Records:", students)

print("Student Name:", students["S101"]["name"])
print("Student Marks:", students.get("S102"))

students["S104"] = {"name": "Anu", "marks": 92}

students["S101"]["marks"] = 95

print("Updated Records:", students)

duplicates = [
    ("S101", "Rahul"),
    ("S102", "Priya"),
    ("S101", "Rahul"),
    ("S103", "Arun")
]

unique_students = dict(duplicates)

print("Unique Students:", unique_students)

removed = students.pop("S103")

print("Removed Student:", removed)
print("Total Students:", len(students))

for student_id, details in students.items():
    print("Student ID:", student_id)
    print("Name:", details["name"])
    print("Marks:", details["marks"])

print("Student Dictionary Completed!")
