import random
import math

# Lucky number
lucky_number = random.randint(1, 100)
print("Your lucky number is:", lucky_number)

# Random activity
activities = ["Play football", "Read a book", "Draw", "Play a game", "Go cycling"]
activity = random.choice(activities)
print("Your random activity is:", activity)

# Number guessing game
secret_number = random.randint(1, 10)

print("\nGuess a number between 1 and 10")

while True:
    guess = int(input("Enter your guess: "))

    if guess == secret_number:
        print("Correct! You guessed the number.")
        break
    elif guess < secret_number:
        print("Too low!")
    else:
        print("Too high!")

# Math calculations
print("\n--- Math Calculator ---")

num1 = float(input("Enter a decimal number: "))
num2 = int(input("Enter a whole number: "))

print("Ceiling value:", math.ceil(num1))
print("Floor value:", math.floor(num1))
print("Absolute value:", math.fabs(num1))
print("Copied sign value:", math.copysign(num1, num2))

num3 = int(input("Enter another whole number for GCD: "))
print("GCD:", math.gcd(num2, num3))

print("\nProgram finished!")